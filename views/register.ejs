<!DOCTYPE html>
<html>
<head>
  <title>Register</title>

  <style>
    body {
      font-family: Arial;
      background: #eef2f7;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
    }

    .container {
      background: #ddd;
      padding: 30px;
      border-radius: 20px;
      width: 350px;
      text-align: center;
    }

    h1 {
      margin-bottom: 20px;
    }

    input {
      width: 100%;
      padding: 12px;
      margin-bottom: 15px;
      border-radius: 10px;
      border: 1px solid #ccc;
    }

    button {
      width: 100%;
      padding: 12px;
      border-radius: 10px;
      border: none;
      background: #1e63e9;
      color: white;
      font-size: 16px;
      cursor: pointer;
    }

    a {
      display: block;
      margin-top: 15px;
      color: purple;
      text-decoration: none;
    }
  </style>
</head>

<body>

  <div class="container">
    <h1>Register</h1>

    <form method="POST" action="/register">
      <input name="username" placeholder="Username" required>
      <input name="email" placeholder="Email" required>
      <input type="password" name="password" placeholder="Password" required>

      <button type="submit">Register</button>
    </form>

    <a href="/login">Already have an account? Login</a>
  </div>

</body>
</html>